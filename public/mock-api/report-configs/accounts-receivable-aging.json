{
  "reportConfigId": "accounts-receivable-aging",
  "name": "Accounts Receivable Aging",
  "description": "Outstanding invoices grouped by age.",
  "fields": [
    {
      "key": "asAt",
      "label": "As at date",
      "type": "date",
      "required": true
    },
    {
      "key": "buckets",
      "label": "Aging buckets",
      "type": "multiSelect",
      "required": true,
      "defaultValue": [
        "0-30",
        "31-60",
        "61-90",
        "90+"
      ],
      "options": [
        {
          "value": "0-30",
          "label": "0–30 days"
        },
        {
          "value": "31-60",
          "label": "31–60 days"
        },
        {
          "value": "61-90",
          "label": "61–90 days"
        },
        {
          "value": "90+",
          "label": "Over 90 days"
        }
      ]
    },
    {
      "key": "minBalance",
      "label": "Minimum balance",
      "type": "number",
      "min": 0,
      "step": 0.01,
      "placeholder": "0.00"
    },
    {
      "key": "customerId",
      "label": "Customer ID",
      "type": "text",
      "pattern": "C-[0-9]{5}",
      "placeholder": "C-12345"
    },
    {
      "key": "customerName",
      "label": "Customer name",
      "type": "text",
      "minLength": 2,
      "maxLength": 80
    },
    {
      "key": "postcode",
      "label": "Postcode",
      "type": "text",
      "pattern": "[0-9]{4}",
      "maxLength": 4
    }
  ],
  "choices": [
    {
      "label": "Customer",
      "helpText": "Find the customer by ID, or by name and postcode.",
      "alternatives": [
        [
          "customerId"
        ],
        [
          "customerName",
          "postcode"
        ]
      ]
    }
  ],
  "columns": [
    {
      "key": "customer_name",
      "label": "Customer"
    },
    {
      "key": "aging_bucket",
      "label": "Age"
    },
    {
      "key": "balance",
      "label": "Balance",
      "format": "decimal"
    }
  ]
}
