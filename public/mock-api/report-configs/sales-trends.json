{
  "reportConfigId": "sales-trends",
  "name": "Sales Trends",
  "description": "Rolling trend lines for product lines over time.",
  "fields": [
    {
      "key": "period",
      "label": "Trend period",
      "type": "dateRange",
      "required": true,
      "minDate": "2020-01-01"
    },
    {
      "key": "productLine",
      "label": "Product line",
      "type": "select",
      "required": true,
      "placeholder": "Select a product line",
      "options": [
        {
          "value": "hardware",
          "label": "Hardware"
        },
        {
          "value": "software",
          "label": "Software"
        },
        {
          "value": "services",
          "label": "Services"
        }
      ]
    },
    {
      "key": "windowMonths",
      "label": "Rolling window (months)",
      "type": "number",
      "required": true,
      "defaultValue": 3,
      "min": 1,
      "max": 24,
      "step": 1
    }
  ],
  "columns": [
    {
      "key": "sales_month",
      "label": "Month",
      "format": "month"
    },
    {
      "key": "total_amount",
      "label": "Sales",
      "format": "decimal"
    },
    {
      "key": "rolling_avg",
      "label": "Rolling average",
      "format": "decimal"
    }
  ]
}
