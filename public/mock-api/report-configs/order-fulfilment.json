{
  "reportConfigId": "order-fulfilment",
  "name": "Order Fulfilment",
  "description": "Order cycle times and on-time delivery rates.",
  "fields": [
    {
      "key": "period",
      "label": "Order date range",
      "type": "dateRange",
      "required": true,
      "minDate": "2024-01-01",
      "maxDate": "2026-12-31"
    },
    {
      "key": "warehouses",
      "label": "Warehouses",
      "type": "multiSelect",
      "options": [
        {
          "value": "syd",
          "label": "Sydney"
        },
        {
          "value": "mel",
          "label": "Melbourne"
        },
        {
          "value": "bne",
          "label": "Brisbane"
        },
        {
          "value": "per",
          "label": "Perth"
        }
      ]
    },
    {
      "key": "slaHours",
      "label": "SLA threshold (hours)",
      "type": "number",
      "defaultValue": 48,
      "min": 1,
      "max": 720
    }
  ],
  "columns": [
    {
      "key": "warehouse_code",
      "label": "Warehouse"
    },
    {
      "key": "orders",
      "label": "Orders",
      "format": "integer"
    },
    {
      "key": "avg_hours_to_ship",
      "label": "Avg. hours to ship",
      "format": "decimal"
    },
    {
      "key": "on_time_rate",
      "label": "On-time rate",
      "format": "percent"
    }
  ]
}
