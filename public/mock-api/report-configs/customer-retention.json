{
  "reportConfigId": "customer-retention",
  "name": "Customer Retention",
  "description": "Cohort retention for customers acquired in a period.",
  "fields": [
    {
      "key": "cohortStart",
      "label": "Cohort start date",
      "type": "date",
      "required": true,
      "maxDate": "2026-12-31"
    },
    {
      "key": "months",
      "label": "Months to track",
      "type": "number",
      "required": true,
      "defaultValue": 12,
      "min": 1,
      "max": 36
    },
    {
      "key": "regions",
      "label": "Regions",
      "type": "multiSelect",
      "options": [
        {
          "value": "north",
          "label": "North"
        },
        {
          "value": "south",
          "label": "South"
        },
        {
          "value": "east",
          "label": "East"
        },
        {
          "value": "west",
          "label": "West"
        }
      ],
      "helpText": "Leave empty to include all regions."
    }
  ],
  "columns": [
    {
      "key": "months_since_acquisition",
      "label": "Months since acquisition",
      "format": "integer"
    },
    {
      "key": "retained_customers",
      "label": "Retained customers",
      "format": "integer"
    }
  ]
}
