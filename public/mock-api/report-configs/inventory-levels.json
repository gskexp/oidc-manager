{
  "reportConfigId": "inventory-levels",
  "name": "Inventory Levels",
  "description": "Stock on hand by warehouse and SKU.",
  "fields": [
    {
      "key": "asAt",
      "label": "As at date",
      "type": "date"
    },
    {
      "key": "warehouses",
      "label": "Warehouses",
      "type": "multiSelect",
      "minSelected": 1,
      "maxSelected": 3,
      "options": [
        {
          "value": "syd",
          "label": "Sydney"
        },
        {
          "value": "mel",
          "label": "Melbourne"
        },
        {
          "value": "bne",
          "label": "Brisbane"
        },
        {
          "value": "per",
          "label": "Perth"
        }
      ],
      "helpText": "Select up to 3 warehouses."
    },
    {
      "key": "skuPrefix",
      "label": "SKU prefix",
      "type": "text",
      "maxLength": 12,
      "pattern": "[A-Z0-9-]+",
      "helpText": "Uppercase letters, digits and hyphens only."
    },
    {
      "key": "belowReorderOnly",
      "label": "Stock filter",
      "type": "select",
      "defaultValue": "all",
      "options": [
        {
          "value": "all",
          "label": "All items"
        },
        {
          "value": "below-reorder",
          "label": "Below reorder point only"
        }
      ]
    }
  ],
  "columns": [
    {
      "key": "warehouse_code",
      "label": "Warehouse"
    },
    {
      "key": "sku",
      "label": "SKU"
    },
    {
      "key": "quantity_on_hand",
      "label": "On hand",
      "format": "integer"
    },
    {
      "key": "reorder_point",
      "label": "Reorder point",
      "format": "integer"
    }
  ]
}
