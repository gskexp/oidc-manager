{
  "reportConfigId": "monthly-sales",
  "name": "Monthly Sales",
  "description": "Sales totals by month for the selected period and regions.",
  "fields": [
    {
      "key": "period",
      "label": "Reporting period",
      "type": "dateRange",
      "required": true
    },
    {
      "key": "regions",
      "label": "Regions",
      "type": "multiSelect",
      "minSelected": 1,
      "options": [
        {
          "value": "north",
          "label": "North"
        },
        {
          "value": "south",
          "label": "South"
        },
        {
          "value": "east",
          "label": "East"
        },
        {
          "value": "west",
          "label": "West"
        }
      ]
    },
    {
      "key": "currency",
      "label": "Currency",
      "type": "select",
      "defaultValue": "USD",
      "options": [
        {
          "value": "USD",
          "label": "US Dollar"
        },
        {
          "value": "EUR",
          "label": "Euro"
        }
      ]
    },
    {
      "key": "minAmount",
      "label": "Minimum order amount",
      "type": "number",
      "min": 0
    }
  ],
  "columns": [
    {
      "key": "sales_month",
      "label": "Month",
      "format": "month"
    },
    {
      "key": "region",
      "label": "Region"
    },
    {
      "key": "total_amount",
      "label": "Total sales",
      "format": "decimal"
    },
    {
      "key": "order_count",
      "label": "Orders",
      "format": "integer"
    }
  ]
}
