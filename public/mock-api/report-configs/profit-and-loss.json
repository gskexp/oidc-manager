{
  "reportConfigId": "profit-and-loss",
  "name": "Profit and Loss",
  "description": "Income statement for a period by cost centre.",
  "fields": [
    {
      "key": "period",
      "label": "Financial period",
      "type": "dateRange",
      "required": true
    },
    {
      "key": "costCentre",
      "label": "Cost centre code",
      "type": "text",
      "pattern": "CC-[0-9]{4}",
      "placeholder": "CC-1234",
      "helpText": "Format: CC- followed by four digits. Leave empty for all cost centres."
    },
    {
      "key": "currency",
      "label": "Currency",
      "type": "select",
      "defaultValue": "USD",
      "options": [
        {
          "value": "USD",
          "label": "US Dollar"
        },
        {
          "value": "EUR",
          "label": "Euro"
        }
      ]
    }
  ],
  "columns": [
    {
      "key": "account_type",
      "label": "Account type"
    },
    {
      "key": "account_name",
      "label": "Account"
    },
    {
      "key": "amount",
      "label": "Amount",
      "format": "decimal"
    }
  ]
}
