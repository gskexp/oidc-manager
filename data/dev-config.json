{
  "environment": "dev",
  "endpoints": {
    "registrationEndpoint": "https://api.dev.example.com/devices/v1/register",
    "b2bTokenEndpoint": "https://auth.dev.example.com/oauth2/b2b/token",
    "oidcAuthEndpoint": "https://login.dev.example.com/realms/partners/protocol/openid-connect/auth",
    "oidcTokenEndpoint": "https://login.dev.example.com/realms/partners/protocol/openid-connect/token",
    "finalTokenEndpoint": "https://auth.dev.example.com/oauth2/exchange/token",
    "targetApiEndpoint": "https://api.dev.example.com/orders/v1/orders?limit=5"
  },
  "oauth": {
    "clientId": "b2b-partner-client-dev",
    "redirectUri": "https://localhost:8443/callback",
    "scope": "openid profile orders.read",
    "b2bScope": "b2b.partner",
    "b2bAuthMethod": "private_key_jwt",
    "username": "partner.tester@dev.example.com",
    "password": "Dev-Passw0rd!",
    "loginUsernameField": "username",
    "loginPasswordField": "password",
    "b2bTokenPlacement": "header",
    "b2bTokenParamName": "b2b_token",
    "usePkce": true
  },
  "jks": {
    "jksPath": "data/dev-keystore.jks",
    "jksPassword": "changeit-dev",
    "keys": [
      { "name": "Orders Service Account (RSA)", "alias": "dev-orders-svc" },
      { "name": "Billing Service Account (EC P-256)", "alias": "dev-billing-svc" }
    ]
  }
}
