{
  "environment": "prod",
  "endpoints": {
    "registrationEndpoint": "https://api.example.com/devices/v1/register",
    "b2bTokenEndpoint": "https://auth.example.com/oauth2/b2b/token",
    "oidcAuthEndpoint": "https://login.example.com/realms/partners/protocol/openid-connect/auth",
    "oidcTokenEndpoint": "https://login.example.com/realms/partners/protocol/openid-connect/token",
    "finalTokenEndpoint": "https://auth.example.com/oauth2/exchange/token",
    "targetApiEndpoint": "https://api.example.com/orders/v1/orders?limit=5"
  },
  "oauth": {
    "clientId": "b2b-partner-client-prod",
    "redirectUri": "https://partner.example.com/oauth/callback",
    "scope": "openid profile orders.read",
    "b2bScope": "b2b.partner",
    "b2bAuthMethod": "private_key_jwt",
    "username": "${PROD_USERNAME}",
    "password": "${PROD_USER_PASSWORD}",
    "loginUsernameField": "username",
    "loginPasswordField": "password",
    "b2bTokenPlacement": "header",
    "b2bTokenParamName": "b2b_token",
    "usePkce": true
  },
  "jks": {
    "jksPath": "data/prod-keystore.jks",
    "jksPassword": "${PROD_JKS_PASSWORD}",
    "keys": [
      { "name": "Orders Service Account (RSA)", "alias": "prod-orders-svc-2026" },
      { "name": "Billing Service Account (EC P-256)", "alias": "prod-billing-svc-2026" }
    ]
  }
}
